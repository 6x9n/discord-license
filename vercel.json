{
  "rewrites": [
    { "source": "/mythicisadminofthisapp", "destination": "/admin/index.html" },
    { "source": "/mythicisadminofthisapp/", "destination": "/admin/index.html" },
    { "source": "/mythicisadminofthisapp/admin.css", "destination": "/admin/admin.css" },
    { "source": "/mythicisadminofthisapp/admin.js", "destination": "/admin/admin.js" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PATCH, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}